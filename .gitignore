# dependencies
/node_modules
/.pnp
.pnp.js
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.sqlite3

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/staticfiles/

