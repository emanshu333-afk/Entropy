DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
# For LAN testing (e.g., 192.168.137.x hotspot), add your LAN IP here or rely on DEBUG='True' which allows '*' + auto-discovery
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-your-password
DB_HOST=localhost
DB_PORT=5432

# OTP via sendotp.email — per BunkLoop_SendOTP_Email_Integration_Guide.md
# Env var must be exactly `otp_email_key` (lowercase, do not rename). Never commit real key, never expose to frontend.
# Get key from https://sendotp.email and set:
# otp_email_key=
# SENDOTP_BASE_URL=https://api.sendotp.email
# SENDOTP_PURPOSE_SIGNUP=signup

# Redis (Channels layer) — use service name 'redis' inside Docker, localhost outside
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# In Docker Compose, set REDIS_HOST=redis and DB_HOST=db

# Email (production: smtp)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@bunkloop.local

# Payments (mock by default — set real keys for live gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Email validation — comma-separated (env-driven, was hard-coded in forms.py)
# ALLOWED_EMAIL_DENIED_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,aol.com
# ALLOWED_ACADEMIC_SUFFIXES=.edu,.ac.,university,edu.

# OTP — length and TTL seconds (was hard-coded 6 and 600)
# OTP_LENGTH=6
# OTP_TTL_SECONDS=600

# Chat — max length, rate limit per minute, pagination max (was hard-coded 5000, 30, 100)
# CHAT_MAX_MESSAGE_LENGTH=5000
# CHAT_RATE_LIMIT_PER_MINUTE=30
# CHAT_PAGINATION_MAX_LIMIT=100

# LAN discovery for auto-adding host IP to ALLOWED_HOSTS/CSRF (was hard-coded 8.8.8.8)
# LAN_DISCOVERY_IP=8.8.8.8
# LAN_DISCOVERY_PORT=80

# Media / Static (for S3 in production, else local)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=